# Veil Agent Server Environment Configuration
# Copy this template to .env and configure.
# Invariant: NEVER commit .env or secrets to version control!

# 1. Server Security & Authentication
VEIL_SERVER_TOKEN=veil-shared-secret-token-change-in-production

# 2. Planner Backend ("deterministic" | "local_vlm" | "cloud_vlm")
VEIL_PLANNER_BACKEND=deterministic

# 3. Local VLM Backend (Qwen2.5-VL-7B-Instruct / Qwen2.5-VL-3B-Instruct)
# Pinned Models:
# - Default: Qwen2.5-VL-7B-Instruct (Apache-2.0)
# - Small / CPU option: Qwen2.5-VL-3B-Instruct (Apache-2.0, set VEIL_SMALL_MODEL=1)
LOCAL_VLM_URL=http://127.0.0.1:11434/v1/chat/completions
LOCAL_VLM_MODEL=qwen2.5-vl:7b
VEIL_SMALL_MODEL=0
LOCAL_VLM_TIMEOUT=12.0

# 4. Cloud VLM Backend (Optional)
# Invariant: Server strictly refuses to initialize CloudVLM unless VEIL_ALLOW_CLOUD=1.
# Privacy Notice: Enabling Cloud VLM transmits the redacted DOM and redacted screenshot
# to the configured third-party model inference provider.
VEIL_ALLOW_CLOUD=0
VEIL_CLOUD_API_KEY=
VEIL_CLOUD_PROVIDER=openai
VEIL_CLOUD_URL=https://api.openai.com/v1/chat/completions
VEIL_CLOUD_MODEL=gpt-4o-mini
VEIL_CLOUD_TIMEOUT=15.0
