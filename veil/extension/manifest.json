{
  "manifest_version": 3,
  "name": "Veil Agent - Smart Form Autofill",
  "version": "0.2.0",
  "description": "Privacy-preserving on-device form autofill agent. Vault details stay 100% on your device.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/orchestrator.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["workers/pii.js", "privacy/injection-shield.js", "content/dom-capture.js", "content/executor.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Veil Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["workers/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
